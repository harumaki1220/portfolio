---
import { SKILLS } from '../data/profile';
import Chips from './Chips.astro';
---

<div class="skills">
  {SKILLS.map((category) => (
    <div class="skill-category">
      <h3 class="skill-category-name">{category.name}</h3>
      {category.others.length === 0 ? (
        // 分ける意味がない分類は、ラベルなしで1行に並べる
        <Chips items={category.main} />
      ) : (
        <dl>
          <div class="skill-group">
            <dt>Main</dt>
            <dd>
              <Chips items={category.main} main />
            </dd>
          </div>
          <div class="skill-group">
            <dt>Others</dt>
            <dd>
              <Chips items={category.others} />
            </dd>
          </div>
        </dl>
      )}
    </div>
  ))}
</div>

<style>
  .skills {
    display: grid;
    gap: 20px;
    font-size: 14px;
  }

  .skill-category-name {
    margin: 0 0 8px;
    color: var(--fg-active);
    font-family: var(--rounded);
    font-size: 15px;
    font-weight: 700;
  }

  .skill-category dl {
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .skill-group {
    display: grid;
    grid-template-columns: 6em 1fr;
    align-items: center;
    gap: 16px;
  }

  .skill-group dt {
    color: var(--muted);
  }

  .skill-group dd {
    margin: 0;
  }

  @media (max-width: 480px) {
    .skill-group {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
