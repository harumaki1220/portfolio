---
// 角丸の小さなタグを横に並べる。main を付けるとアクセントカラーになる
interface Props {
  items: string[];
  main?: boolean;
}

const { items, main = false } = Astro.props;
---

<ul class:list={['chips', { 'chips-main': main }]}>
  {items.map((item) => (
    <li class="chip">{item}</li>
  ))}
</ul>

<style>
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.6;
  }

  .chips-main .chip {
    border-color: transparent;
    background: var(--main-soft);
    color: var(--main);
  }
</style>
