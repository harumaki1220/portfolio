---
// ダーク / ライトの切り替え。初期値は BaseLayout の <head> のスクリプトが
// <html data-theme="..."> に設定済み。アイコンの出し分けは CSS でやる。
// アイコンの形は Lucide（ISC ライセンス）の sun / moon から
---

<button class="theme-toggle" type="button" aria-label="ダーク / ライトを切り替え">
  <svg
    class="theme-toggle-to-light"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="theme-toggle-to-dark"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  const button = document.querySelector(".theme-toggle");
  button?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "light" ? "dark" : "light";
    root.dataset.theme = next;
    // プライベートモードなどで保存できなくても、切り替え自体はできるので無視する
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });
</script>
