---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Chips from '../components/Chips.astro';
import { NAME, WORKS } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`Works | ${NAME}`}>
  <h1 class="page-title">Works</h1>
  <ul class="works">
    {WORKS.map((work) => (
      <li class="work">
        <div class="work-header">
          <h2 class="work-name">{work.name}</h2>
          <time class="work-date">{work.date}</time>
        </div>
        <p class="work-description">{work.description}</p>
        <Chips items={work.tech} />
        <p class="work-links">
          {work.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <ArrowUpRight />
            </a>
          ))}
        </p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .work {
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    transition: border-color 0.15s;
  }

  .work:hover {
    border-color: var(--accent);
  }

  /* タグは Chips の部品の中なので、:global で指定する */
  .work :global(.chips) {
    margin-top: 12px;
  }

  .work-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .work-date {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
  }

  .work-name {
    margin: 0;
    color: var(--fg-active);
    font-family: var(--rounded);
    font-weight: 700;
    font-size: 16px;
  }

  .work-description {
    margin: 4px 0 0;
  }

  .work-links {
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    color: var(--muted);
    font-size: 13px;
  }

  .work-links a {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
  }

  .work-links a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
