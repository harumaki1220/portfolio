---
import BrandIcon from '../components/BrandIcon.astro';
import Skills from '../components/Skills.astro';
import {
  ABOUT,
  ICON_CREDIT,
  ICON_URL,
  LIKES,
  LINKS,
  NAME,
} from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={NAME}>
  <header class="home-header">
    <img class="home-icon" src={ICON_URL} alt="" width="96" height="96" />
    <h1 class="home-name">{NAME}</h1>
  </header>

  <section>
    <h2 class="home-heading">About</h2>
    <div class="about-text">
      {ABOUT.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section>
    <h2 class="home-heading">Skills</h2>
    <Skills />
  </section>

  <section>
    <h2 class="home-heading">Likes</h2>
    <ul class="likes">
      {LIKES.map((like) => (
        <li>{like}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="home-heading">Links</h2>
    <ul class="home-links">
      {LINKS.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <BrandIcon icon={link.icon} />
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <footer class="home-credit">
    <p>
      Icon by{' '}
      <a href={ICON_CREDIT.href} target="_blank" rel="noopener noreferrer">
        {ICON_CREDIT.label}
      </a>{' '}
      🎨
    </p>
  </footer>
</BaseLayout>

<style>
  .home-header {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .home-icon {
    flex-shrink: 0;
    width: 96px;
    height: 96px;
    border: 2px solid var(--main);
    border-radius: 50%;
  }

  .home-name {
    margin: 0;
    color: var(--fg-active);
    font-family: var(--rounded);
    font-weight: 700;
    font-size: clamp(2.25rem, 8vw, 3rem);
    line-height: 1.2;
  }

  .home-heading {
    margin: 0 0 12px;
    color: var(--main);
    font-family: var(--rounded);
    font-size: 20px;
    font-weight: 700;
  }

  .about-text {
    display: grid;
    gap: 4px;
  }

  .about-text p {
    margin: 0;
  }

  .likes {
    margin: 0;
    padding-left: 1.25em;
    font-size: 15px;
  }

  .home-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
  }

  .home-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg);
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .home-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .home-credit p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
  }

  .home-credit a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .home-credit a:hover {
    color: var(--accent);
  }
</style>
