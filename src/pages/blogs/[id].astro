---
import { render } from 'astro:content';
import Chips from '../../components/Chips.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatDate, getPosts } from '../../data/blog';
import { url } from '../../data/pages';
import { NAME } from '../../data/profile';
import BaseLayout from '../../layouts/BaseLayout.astro';

// ビルドのときに1回だけ動いて、記事の数だけページを作る
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 目次に出すのは ## と ### だけ。見出しが少ない記事では目次を出さない
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const hasToc = tocHeadings.length >= 2;
---

<BaseLayout
  title={`${post.data.title} | ${NAME}`}
  description={post.data.description}
  type="article"
>
  <article class="post">
    <header class="post-header">
      <a class="post-back" href={url('blogs/')}>
        ← Blogs
      </a>
      <h1 class="page-title">{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {post.data.draft && <span class="draft-badge">下書き</span>}
      </div>
      {post.data.tags.length > 0 && <Chips items={post.data.tags} />}
    </header>
    {hasToc && (
      <details class="toc-mobile">
        <summary>目次</summary>
        <TableOfContents headings={tocHeadings} />
      </details>
    )}
    <div class="prose">
      <Content />
    </div>
    {hasToc && (
      <aside class="toc-side">
        <nav aria-label="目次">
          <p class="toc-title">目次</p>
          <TableOfContents headings={tocHeadings} />
        </nav>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* 広い画面では、本文の右に目次を置いて、スクロールしても残るようにする */
  @media (min-width: 1024px) {
    .post {
      grid-template-columns: minmax(0, 1fr) 220px;
      column-gap: 48px;
    }

    .post-header,
    .prose {
      grid-column: 1;
    }

    .toc-side {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .toc-mobile {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .toc-side {
      display: none;
    }
  }

  .toc-side nav {
    position: sticky;
    top: 24px;
  }

  .toc-title {
    margin: 0 0 8px;
    color: var(--fg-active);
    font-family: var(--rounded);
    font-size: 14px;
    font-weight: 700;
  }

  /* スマホでは、記事の上に折りたたみで置く */
  .toc-mobile {
    margin-top: 24px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
  }

  .toc-mobile summary {
    color: var(--fg-active);
    font-family: var(--rounded);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
  }

  .toc-mobile[open] summary {
    margin-bottom: 8px;
  }

  .post-header {
    display: grid;
    gap: 8px;
  }

  .post-back {
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }

  .post-back:hover {
    color: var(--accent);
  }
</style>
