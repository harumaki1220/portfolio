---
import { url } from '../data/pages';
import { NAME } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`404 | ${NAME}`}>
  <div class="not-found">
    <p class="not-found-code">404</p>
    <h1 class="page-title">ページが見つかりませんでした</h1>
    <p class="placeholder">
      URL が間違っているか、ページが移動した可能性があります。
    </p>
    <a class="not-found-link" href={url('')}>
      Home に戻る
    </a>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: 12px;
  }

  .not-found-code {
    margin: 0;
    color: var(--main);
    font-family: var(--rounded);
    font-size: clamp(4rem, 16vw, 6rem);
    font-weight: 700;
    line-height: 1;
  }

  .not-found-link {
    margin-top: 12px;
    padding: 8px 20px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg);
    text-decoration: none;
    transition:
      border-color 0.15s,
      color 0.15s;
  }

  .not-found-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
