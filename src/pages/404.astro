---
import { url } from "../data/pages";
import { NAME } from "../data/profile";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={`404 | ${NAME}`}>
  <div class="not-found">
    <p class="not-found-code">404</p>
    <h1 class="page-title">ページが見つかりませんでした</h1>
    <p class="placeholder">URL が間違っているか、ページが移動した可能性があります。</p>
    <a class="not-found-link" href={url("")}>Home に戻る</a>
  </div>
</BaseLayout>
